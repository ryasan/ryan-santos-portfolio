{
  "name": "ryan-santos-portfolio",
  "private": true,
  "sideEffects": false,
  "type": "commonjs",
  "scripts": {
    "build": "npm run codegen && npm run typecheck && npm run build:css && remix vite:build",
    "build:css": "sass app/styles/:public/styles",
    "clean": "rm -rf build node_modules",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "dev": "concurrently \"npm run sass:dev\" \"remix vite:dev\"",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "sass:dev": "sass --watch app/styles/:public/styles",
    "serve": "netlify serve",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@conform-to/react": "^1.10.1",
    "@conform-to/zod": "^1.10.1",
    "@contentful/rich-text-react-renderer": "^16.1.5",
    "@contentful/rich-text-types": "^17.2.4",
    "@graphql-codegen/typescript-graphql-request": "^6.3.0",
    "@gsap/react": "^2.1.2",
    "@netlify/edge-functions": "^2.3.1",
    "@netlify/remix-edge-adapter": "^3.5.0",
    "@netlify/remix-runtime": "^2.4.0",
    "@remix-run/node": "^2.17.2",
    "@remix-run/react": "^2.17.2",
    "@remix-run/serve": "^2.17.2",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.4",
    "graphql-request": "^7.2.0",
    "gsap": "^3.13.0",
    "isbot": "^4.1.0",
    "keen-slider": "^6.8.6",
    "lodash": "^4.17.21",
    "plaiceholder": "^3.0.0",
    "popmotion": "^11.0.5",
    "react-locomotive-scroll": "^0.2.2",
    "react-syntax-highlighter": "^15.6.6",
    "sharp": "^0.33.5",
    "swiper": "^11.2.4",
    "three": "^0.180.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@epic-web/config": "^1.12.0",
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/introspection": "^5.0.0",
    "@graphql-codegen/typescript": "^5.0.1",
    "@graphql-codegen/typescript-operations": "^5.0.1",
    "@remix-run/dev": "^2.17.2",
    "@types/locomotive-scroll": "^4.1.3",
    "@types/lodash": "^4.17.7",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.180.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "concurrently": "^9.0.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "locomotive-scroll": "^4.1.4",
    "prettier": "^3.5.0",
    "prettier-plugin-css-order": "^2.1.2",
    "sass": "1.77.6",
    "stylelint": "^16.9.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.6",
    "vite": "^5.0.0",
    "vite-env-only": "^3.0.3",
    "vite-plugin-checker": "^0.11.0",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "prettier": "@epic-web/config/prettier"
}
